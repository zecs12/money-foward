# このファイルを .env という名前でコピーして、実際の値を入力してください。
# 例: cp .env.example .env
#
# .env ファイルは絶対に Git にコミットしないでください（.gitignore で除外済みです）。

# マネーフォワードMEのログインID・パスワード（アカウントA：楽天銀行・楽天証券をひもづけている方）
MF_ACCOUNT_A_EMAIL=your-email@example.com
MF_ACCOUNT_A_PASSWORD=your-password

# ブラウザを画面表示するかどうか（true: 画面を表示して動作確認、false: 画面なしで実行）
# 初回はログイン画面を目で確認できるよう true を推奨します。
MF_HEADLESS=false
